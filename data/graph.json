      "data": {
        "title": "Keyframe prompt · 1 · The ping · 0-5s",
        "text": "Cinematic night shot, a tired startup founder at a kitchen-table desk at 11pm, laptop glow on his face, a Slack notification on screen reading 'Can you send your SOC 2 report?' from a huge enterprise logo. Cold blue light, shallow depth of field."
      },
      "measured": {
        "width": 288,
        "height": 192
      }
    },
    {
      "id": "mp1",
      "type": "prompt",
      "position": {
        "x": 340,
        "y": 560
      },
      "data": {
        "title": "Motion + VO · Scene 1",
        "text": "Slow push-in on his face as the notification pops. His eyes widen, a beat of dread. Camera drifts to the screen. SFX: ping. VO: 'The biggest deal of your life just asked one question.'"
      },
      "measured": {
        "width": 288,
        "height": 192
      }
