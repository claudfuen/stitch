  "story": {
    "title": "The Ministry",
    "runtime": 40,
    "logline": "Henrick takes a founder to get SOC 2 the European way. It takes eleven years. Then Comp AI does it in six seconds, and Henrick has to say the word.",
    "sections": [
      {
        "id": "hook",
        "name": "Hook",
        "color": "#f59e0b",
        "start": 0,
        "end": 5,
        "purpose": "Henrick makes 'Friday' sound like a diagnosis."
      },
      {
        "id": "ministry",
        "name": "The Ministry",
        "color": "#f43f5e",
        "start": 5,
        "end": 24,
        "purpose": "Escalate the absurdity: queue, form, fax, eleven years."
      },
      {
        "id": "turn",
        "name": "Turn",
        "color": "#38bdf8",
        "start": 24,
        "end": 30,
        "purpose": "Hard contrast: bright, calm, six seconds."
      },
      {
        "id": "payoff",
        "name": "Payoff",
        "color": "#34d399",
        "start": 30,
        "end": 36,
        "purpose": "Henrick has to say it. Real footage."
      },
      {
        "id": "cta",
        "name": "Call to action",
        "color": "#a78bfa",
        "start": 36,
        "end": 40,
        "purpose": "The binder goes in the bin. One line, one logo."
      }
    ],
    "beats": [
      {
        "scene": 1,
        "name": "The request",
        "start": 0,
        "end": 5,
        "section": "hook",
        "vo": "Static locked-off two-shot. Founder: 'Henrick, I need SOC 2 by Friday.' Long pause. Henrick closes the book: 'Friday.' Beat. 'In Europe, we "
      },
      {
        "scene": 2,
        "name": "The Ministry",
        "start": 5,
        "end": 12,
        "section": "ministry",
        "vo": "Slow dolly through the hall. Ticket machine ding. Founder: 'What number are they on?' Henrick, calm: 'Seventeen.' LED reads 4,201,990. An el"
      },
      {
        "scene": 3,
        "name": "Form 27-B",
        "start": 12,
        "end": 19,
        "section": "ministry",
        "vo": "Clerk: 'To apply for the form, you must first complete the form.' Founder: 'Is there a portal?' Clerk, reverent: 'There is a fax.' She stamp"
      },
      {
        "scene": 4,
        "name": "Eleven years",
        "start": 19,
        "end": 24,
        "section": "ministry",
        "vo": "Time-lapse calendar flips, dust gathers, founder ages in two seconds while Henrick does not move. Henrick, gently: 'You are doing very well."
      },
      {
        "scene": 5,
        "name": "Comp AI",
        "start": 24,
        "end": 30,
        "section": "turn",
        "vo": "Phone buzzes: 'Comp AI: SOC 2 evidence collected. 100% ready.' Integration tiles slam in, the board flips red to green in six seconds. Found"
      },
      {
        "scene": 6,
        "name": "It is good",
        "start": 30,
        "end": 36,
        "section": "payoff",
        "vo": "REAL FOOTAGE. Slow push-in. He removes his glasses, wipes them. 'In Europe, we would call this impossible.' Long beat. 'It is good.' Burned-"
      },
      {
        "scene": 7,
        "name": "The statement",
        "start": 36,
        "end": 40,
        "section": "cta",
        "vo": "He drops the binder in the bin. 'I have prepared a statement.' "
      }
    ],
